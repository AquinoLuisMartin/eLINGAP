APP_NAME=eLINGAP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your-runtime-role
DB_PASSWORD=
DB_SSLMODE=require
DB_SEARCH_PATH=elingap

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
CACHE_PREFIX=elingap-production-
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
UPLOAD_OPTIMIZE_IMAGES=true

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7
MAIL_MAILER=smtp
