{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/", "dest": "/api/index.php" },
        { "src": "/(.*\\.php|(?:.*/)?\\..*)", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "database-atomic",
        "APP_CONFIG_CACHE": "/tmp/elingap/config.php",
        "APP_EVENTS_CACHE": "/tmp/elingap/events.php",
        "APP_PACKAGES_CACHE": "/tmp/elingap/packages.php",
        "APP_ROUTES_CACHE": "/tmp/elingap/routes.php",
        "APP_SERVICES_CACHE": "/tmp/elingap/services.php",
        "VIEW_COMPILED_PATH": "/tmp/elingap/framework/views"
    }
}
